{
 "id": "digimono",
 "version": "0.3",
 "title": "Digi Mono",
 "category": "Sound",
 "author": "gdeo607",
 "license": "GPL-2.0-or-later",
 "description": "Synth machines for the audio tracks, after the Monomachine's GND and SWAVE machines: MONO SIN, MONO NOISE, MONO SAW (unison, two sub-oscillators), MONO PULSE (PWM, unison, sub) and MONO ENS (four oscillators at set intervals, chorus), in the FUNC+SRC machine list. They need no sample; the track's filter, amp, LFOs and effects work on them as on a sample. A clean-room engine: no Monomachine code or data. The SRC page shows each machine's own knobs (B, C, E, F, G, H); A is TUNE, D the (unused) sample slot.",
 "device": "digitakt-mk1",
